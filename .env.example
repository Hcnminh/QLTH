# Biến môi trường cho EduPrimary-KPI Core API
# Sao chép thành `.env` (đã gitignore) và điền giá trị thật.
# KHÔNG commit file .env chứa secret thật.

# --- API Server ---
# Cổng HTTP của service (mặc định 8080)
PORT=8080
# release | debug | test — Gin runtime mode. Production bắt buộc dùng release.
GIN_MODE=release

# --- PostgreSQL (dùng khi kích hoạt tầng persistence, Giai đoạn 2) ---
# Định dạng: postgres://user:password@host:port/dbname?sslmode=require
DATABASE_URL=postgres://qlth_user:[SECRET]
POSTGRES_USER=qlth_user
POSTGRES_PASSWORD=qlth_password_secure
POSTGRES_DB=qlth_eduprimary

# --- Redis (cache & distributed lock) ---
REDIS_URL=redis://redis:6379/0

# --- Bảo mật dữ liệu trẻ em (NĐ 13/2023 Điều 20) ---
# Khóa AES-256 mã hóa trường nhạy cảm (số định danh, bệnh án).
# Bắt buộc 32 byte. Production: lấy từ secret manager, KHÔNG hardcode.
PII_ENCRYPTION_KEY=
# Bật true để chặn hoàn toàn việc ghi dữ liệu nhạy cảm ra log
PII_LOG_REDACTION=true

# --- Ký số học bạ (Luật Giao dịch điện tử 2023, NĐ 130/2018) ---
# SmartCA / Cloud CA endpoint và thông tin xác thực
SIGNATURE_PROVIDER=smartca
SIGNATURE_API_URL=
SIGNATURE_API_KEY=

# --- VNeID / Định danh điện tử (NĐ 69/2024) ---
VNEID_CLIENT_ID=
VNEID_CLIENT_SECRET=
VNEID_API_URL=

# --- Liên thông CSDL ngành Bộ GD&ĐT (TT 42/2021) ---
MOET_API_URL=
MOET_API_TOKEN=
MOET_SCHOOL_CODE=

# --- Cổng thanh toán VietQR ---
VIETQR_MERCHANT_ID=
VIETQR_API_KEY=
VIETQR_WEBHOOK_SECRET=

# --- Hóa đơn điện tử (NĐ 123/2020, TT 78/2021) ---
EINVOICE_API_URL=
EINVOICE_USERNAME=
EINVOICE_PASSWORD=
EINVOICE_TEMPLATE_CODE=

# --- Trợ lý sư phạm AI (LLM) ---
# Để trống = dùng bộ gợi ý rule-based có sẵn trong handlers.go
AI_COPILOT_PROVIDER=
AI_COPILOT_API_KEY=
AI_COPILOT_MODEL=

# --- Feature flags ---
# Bật/tắt tính năng chưa sẵn sàng cho production (đọc qua config.GetFeatureFlag)
FEATURE_AI_COPILOT_LLM=false
FEATURE_COMPUTER_BASED_EXAM=false
FEATURE_E_SIGNATURE=true

# --- Observability ---
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
